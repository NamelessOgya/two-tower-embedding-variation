# Copy this file to .env and fill in your values
# cp .env.example .env

# HuggingFace token (required for gated models, optional for multilingual-e5)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Override HuggingFace model cache location (default: ./docker/hf_cache)
# HF_CACHE_DIR=/path/to/shared/hf_cache

# Override dataset download location (default: ./data)
# DATA_DIR=/path/to/datasets
